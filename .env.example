# ── Database ──────────────────────────────────────────────────
POSTGRES_DB=fakenews
POSTGRES_USER=fnews
POSTGRES_PASSWORD=fnews_secret

# ── LLM Provider (pick one) ──────────────────────────────────
# Options: gemini, deepseek, openai, openai-compatible, ollama, mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-lite

# Ollama (Local LLM alternative)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:8b

# DeepSeek (Paid API — uses deepseek-chat which supports JSON mode)
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Any OpenAI-compatible Chat Completions API (for example LM Studio, vLLM,
# or a hosted provider). The base URL should include /v1; the SDK appends
# /chat/completions. API key may be left blank for local servers.
# LLM_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=your-model-name


# ── Search API (pick one) ────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ── Fact-Check API ───────────────────────────────────────────
GOOGLE_FACTCHECK_API_KEY=your_factcheck_api_key_here

# ── News API ─────────────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key_here

# ── Pipeline ─────────────────────────────────────────────────
CLAIM_SIMILARITY_THRESHOLD=0.88
CONFIDENCE_ESCALATION_THRESHOLD=0.65
MAX_EVIDENCE_RESULTS=10
TOP_EVIDENCE_COUNT=5
